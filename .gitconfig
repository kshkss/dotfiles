	name = Akishika, Issui
[core]
	editor = nvim
[merge]
	ff = false
[pull]
	ff = only

[maintenance]
	repo = /home/akishika/Git/pure
	repo = /home/akishika/Git/zsh-autocomplete
	repo = /home/akishika/Git/zsh-snap
[init]
	defaultBranch = main
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
